# ---- SUPER ANIMATIC TYPEWRITER ----
typewriter() {
    local text="$1"
    local delay=0.0025
    printf "${B}"
    for ((i=0; i<${#text}; i++)); do
        printf "%s" "${text:$i:1}"
        sleep "$delay"
        
        # Random glitch effect for coolness
        if (( RANDOM % 12 == 0 )); then
            printf "${R}%s${N}" "${text:$i:1}"
            sleep 0.015
            printf "\b${B}%s" "${text:$i:1}"
        fi
    done
    printf "${N}\n"
}

# ---- GLITCH TYPEWRITER (for special lines) ----
glitch_typewriter() {
    local text="$1"
    local delay=0.0015
    printf "${B}"
    for ((i=0; i<${#text}; i++)); do
        printf "%s" "${text:$i:1}"
        sleep "$delay"
        if (( RANDOM % 8 == 0 )); then
            printf "${R}%s${N}" "${text:$((i+1)):1}"
            sleep 0.008
            printf "\b\b${B}%s" "${text:$i:1}"
        fi
    done
    printf "${N}\n"
}

# ---- EPIC PROGRESS BAR ----
progress_bar() {
    echo -e "${DB}    NEURAL CORE AWAKENING...${N}"
    printf "${B}    "
    for i in {1..50}; do
        printf "▓"
        sleep 0.018
    done
    printf "${N}\n\n"

    for i in {0..100..4}; do
        printf "\r${DB}    BOOT SEQUENCE: ${B}%3d%%${N} ${GR}[" "$i"
        for ((j=0; j<i/5; j++)); do printf "█"; done
        for ((j=i/5; j<20; j++)); do printf "░"; done
        printf "${GR}]${N}"
        sleep 0.07
    done
    echo -e "\n"
    sleep 0.5
}

